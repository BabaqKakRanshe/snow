         static Vector3 V3(float[] a) => new Vector3(a[0], a[1], a[2]);
 
+        /// <summary>2 m cells (<paramref name="cell"/> keys) within r of any u7.keepClear segment (exact segment-to-square distance).</summary>
+        static HashSet<long> KeepClearCells(Layout L, Func<float, float, long> cell)
+        {
+            var cells = new HashSet<long>();
+            if (L.u7?.keepClear == null) return cells;
+            foreach (Strip k in L.u7.keepClear)
+            {
+                if (k?.a == null || k.b == null || k.a.Length < 2 || k.b.Length < 2) continue;
+                Vector2 a = new Vector2(k.a[0], k.a[1]), b = new Vector2(k.b[0], k.b[1]);
+                int x0 = Mathf.FloorToInt((Mathf.Min(a.x, b.x) - k.r) / 2f), x1 = Mathf.FloorToInt((Mathf.Max(a.x, b.x) + k.r) / 2f);
+                int z0 = Mathf.FloorToInt((Mathf.Min(a.y, b.y) - k.r) / 2f), z1 = Mathf.FloorToInt((Mathf.Max(a.y, b.y) + k.r) / 2f);
+                for (int cx = x0; cx <= x1; cx++)
+                    for (int cz = z0; cz <= z1; cz++)
+                        if (SegmentToSquare(a, b, new Vector2(cx * 2f, cz * 2f), 2f) <= k.r) cells.Add(cell(cx * 2f + 1f, cz * 2f + 1f));
+            }
+            return cells;
+        }
+
+        /// <summary>Distance from segment a-b to the axis-aligned square [lo, lo + size]² (0 when they touch).</summary>
+        static float SegmentToSquare(Vector2 a, Vector2 b, Vector2 lo, float size)
+        {
+            Vector2 hi = lo + new Vector2(size, size);
+            bool Inside(Vector2 p) => p.x >= lo.x && p.x <= hi.x && p.y >= lo.y && p.y <= hi.y;
+            if (Inside(a) || Inside(b)) return 0f;
+            float PointToSquare(Vector2 p) => new Vector2(Mathf.Max(lo.x - p.x, 0f, p.x - hi.x), Mathf.Max(lo.y - p.y, 0f, p.y - hi.y)).magnitude;
+            float PointToSeg(Vector2 p)
+            {
+                Vector2 d = b - a;
+                float t = d.sqrMagnitude > 1e-8f ? Mathf.Clamp01(Vector2.Dot(p - a, d) / d.sqrMagnitude) : 0f;
+                return (a + d * t - p).magnitude;
+            }
+            Vector2[] c = { lo, new Vector2(hi.x, lo.y), hi, new Vector2(lo.x, hi.y) };
+            for (int i = 0; i < 4; i++)                                   // the segment crosses an edge
+            {
+                Vector2 p = c[i], q = c[(i + 1) % 4], r = b - a, e = q - p;
+                float den = r.x * e.y - r.y * e.x;
+                if (Mathf.Abs(den) < 1e-8f) continue;
+                float t = ((p.x - a.x) * e.y - (p.y - a.y) * e.x) / den, u = ((p.x - a.x) * r.y - (p.y - a.y) * r.x) / den;
+                if (t >= 0f && t <= 1f && u >= 0f && u <= 1f) return 0f;
+            }
+            return Mathf.Min(Mathf.Min(PointToSquare(a), PointToSquare(b)), Mathf.Min(Mathf.Min(PointToSeg(c[0]), PointToSeg(c[1])), Mathf.Min(PointToSeg(c[2]), PointToSeg(c[3]))));
+        }
+
